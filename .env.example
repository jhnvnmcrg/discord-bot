# Postgres (Neon). Created automatically by Neon Launchpad (https://neon.new) on
# first `npm run dev` if unset. The pooled URL is fine here.
DATABASE_URL=
# Optional: a direct (non-pooler) URL for migrations and the bot's LISTEN
# connection. Defaults to DATABASE_URL with "-pooler" removed from the host.
DATABASE_URL_DIRECT=

# Clerk (https://dashboard.clerk.com) — dashboard sign-in
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user ids allowed to manage the bot. Required: when
# empty, nobody can use the dashboard or the API. The dashboard shows your id.
ADMIN_USER_IDS=

# Optional: lets scripts call the REST API with an `x-api-key` header.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
DASHBOARD_API_KEY=

# Discord (https://discord.com/developers/applications) — Bot tab
# Needed by the bot, and by the web app to list channels and roles.
DISCORD_TOKEN=
# Optional: Application ID (General Information). Builds the invite link before
# the bot has ever connected; otherwise the id the bot reports is used.
VITE_DISCORD_CLIENT_ID=

# AI chat (members @mention the bot). Which backend answers:
#   ollama (default) - a model running on this machine. No key, no cloud.
#   gemini           - Google Gemini, needs GEMINI_API_KEY.
AI_PROVIDER=ollama
# Ollama: the model to use (pull it first: ollama pull qwen2.5:3b). If empty,
# the first installed model is used. OLLAMA_HOST defaults to localhost:11434.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=
# Optional: let thinking models think before answering (slower). Default off.
OLLAMA_THINK=
# Optional: how long Ollama keeps the model loaded between messages. Default 30m.
OLLAMA_KEEP_ALIVE=

# Gemini, only used with AI_PROVIDER=gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: Gemini model. Defaults to gemini-3.8-flash; busy models fall back
# to other Gemini models.
GEMINI_MODEL=
